rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Admins can manage employees. All users can read employee list for clock-in.
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if request.auth != null; // Allow writes only for authenticated (admin) users
    }

    // Admins can read/write any time entry. Crew can create/read/update their own.
    match /timeEntries/{timeEntryId} {
      allow read, write: if request.auth != null; // Admin access
      allow create, read, update: if request.auth == null; // Unauthenticated users (crew) can perform clock-in/out actions.
    }

    // Only admins can create/read/write bonuses
    match /bonuses/{bonusId} {
      allow read, write: if request.auth != null;
    }
  }
}
