rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Admins can manage employees. All users can read employee list for clock-in.
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if request.auth != null; // Allow writes only for authenticated (admin) users
    }

    // Admins can read/write any time entry.
    match /timeEntries/{timeEntryId} {
      allow read, write: if request.auth != null; // Admin access
      // Crew can create, get, and update entries.
      allow create, get, update: if request.auth == null; 
    }
    
    // Explicitly allow crew to query the time entries collection. This is required for the clock-in page to work.
    match /timeEntries {
        allow list: if request.auth == null;
    }

    // Only admins can create/read/write bonuses
    match /bonuses/{bonusId} {
      allow read, write: if request.auth != null;
    }
  }
}
