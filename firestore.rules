rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /timeEntries/{timeEntryId} {
      allow read, write: if true;
    }

    match /bonuses/{bonusId} {
      allow read, write: if true;
    }
  }
}
